,4,1],"nodes":{"inp":[47,48],"output1":49,"controlSignalInput":50}}}],"Ground":[{"x":-50,"y":60,"objectType":"Ground","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":0,"customData":{"nodes":{"output1":12},"constructorParamaters":[1]}}],"ConstantVal":[{"x":860,"y":430,"objectType":"ConstantVal","label":"","direction":"LEFT","labelDirection":"RIGHT","propagationDelay":0,"customData":{"nodes":{"output1":31},"constructorParamaters":["LEFT",32,"00000000000000000000000000000000"]}},{"x":360,"y":10,"objectType":"ConstantVal","label":"","direction":"DOWN","labelDirection":"UP","propagationDelay":0,"customData":{"nodes":{"output1":57},"constructorParamaters":["DOWN",4,"0000"]}}],"Adder":[{"x":-20,"y":20,"objectType":"Adder","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["RIGHT",4],"nodes":{"inpA":2,"inpB":3,"carryIn":4,"carryOut":6,"sum":5}}}],"SubCircuit":[{"x":280,"y":320,"id":"24352196407","label":"","labelDirection":"LEFT","inputNodes":[15,16],"outputNodes":[13,14],"version":"2.0"}],"Tunnel":[{"x":540,"y":330,"objectType":"Tunnel","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["RIGHT",1,"O"],"nodes":{"inp1":51},"values":{"identifier":"O"}}},{"x":490,"y":30,"objectType":"Tunnel","label":"","direction":"UP","labelDirection":"DOWN","propagationDelay":10,"customData":{"constructorParamaters":["UP",1,"O"],"nodes":{"inp1":53},"values":{"identifier":"O"}}}],"Text":[{"x":-550,"y":180,"objectType":"Text","label":"Moltiplicazione in virgola mobile con segno.\nout fornito dalla moltiplicazione a 32 bit.\ncifre decimali in out (out_dec) somma di quelle in input (così come avviene nella moltiplicazione ordinaria in decimale).\nIl segno dell'output è determinato dallo xor dei corrispettivi segnali di ingresso.\nIl segno è  positivo o negativo a secondo che i segni di ingresso siano concordi o discordi. \nL'overflow mette tutte le uscite a 0.\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["Moltiplicazione in virgola mobile con segno.\nout fornito dalla moltiplicazione a 32 bit.\ncifre decimali in out (out_dec) somma di quelle in input (così come avviene nella moltiplicazione ordinaria in decimale).\nIl segno dell'output è determinato dallo xor dei corrispettivi segnali di ingresso.\nIl segno è  positivo o negativo a secondo che i segni di ingresso siano concordi o discordi. \nL'overflow mette tutte le uscite a 0.\n",14]}},{"x":80,"y":-260,"objectType":"Text","label":"Example:\n-21,35 x - 34,69 = 740,6315\n\nA = 100001010111 (2135)\na_dec = 0010 (2)\na_sign = 1\n\nB = 110110001101 (3469)\nb_dec = 0010 (2)\nb_sign = 1\n\nout = 11100010000001011101011 (7406315)\nout_dec = 0100 (4)\nout_sign = 0 \n\n ","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["Example:\n-21,35 x - 34,69 = 740,6315\n\nA = 100001010111 (2135)\na_dec = 0010 (2)\na_sign = 1\n\nB = 110110001101 (3469)\nb_dec = 0010 (2)\nb_sign = 1\n\nout = 11100010000001011101011 (7406315)\nout_dec = 0100 (4)\nout_sign = 0 \n\n ",14]}},{"x":510,"y":-190,"objectType":"Text","label":"Signed floating-point multiplication.\nThe out value is provided by the result of the 32-bit multiplication. The number of decimal digits in the output, out_dec, \nis obtained by summing the number of decimal digits of the two inputs, similarly to standard decimal multiplication.\n\nThe output sign is determined by applying an XOR operation to the corresponding sign signals of the inputs. \nThe result is positive when the input signs are the same and negative when they are different.\n\nIn case of overflow, all outputs are set to 0.","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["Signed floating-point multiplication.\nThe out value is provided by the result of the 32-bit multiplication. The number of decimal digits in the output, out_dec, \nis obtained by summing the number of decimal digits of the two inputs, similarly to standard decimal multiplication.\n\nThe output sign is determined by applying an XOR operation to the corresponding sign signals of the inputs. \nThe result is positive when the input signs are the same and negative when they are different.\n\nIn case of overflow, all outputs are set to 0.",14]}}],"restrictedCircuitElementsUsed":[],"nodes":[7,8,9,10,11,30,32,33,34,35,40,41,44,45,46,52,54,55,56,58,59]},{"layout":{"width":100,"height":400,"title_x":50,"title_y":13,"titleEnabled":true},"verilogMetadata":{"isVerilogCircuit":false,"isMainCircuit":false,"code":"// Write Some Verilog Code Here!","subCircuitScopeIds":[]},"allNodes":[{"x":40,"y":0,"type":1,"bitWidth":4,"label":"","connections":[92]},{"x":40,"y":0,"type":1,"bitWidth":4,"label":"","connections":[190]},{"x":40,"y":0,"type":1,"bitWidth":4,"label":"","connections":[182]},{"x":40,"y":0,"type":1,"bitWidth":4,"label":"","connections":[173]},{"x":40,"y":0,"type":1,"bitWidth":4,"label":"","connections":[316]},{"x":40,"y":0,"type":1,"bitWidth":4,"label":"","connections":[93]},{"x":40,"y":0,"type":1,"bitWidth":4,"label":"","connections":[94]},{"x":40,"y":0,"type":1,"bitWidth":4,"label":"","connections":[95]},{"x":40,"y":0,"type":1,"bitWidth":4,"label":"","connections":[271]},{"x":40,"y":0,"type":1,"bitWidth":4,"label":"","connections":[96]},{"x":0,"y":-50,"type":0,"bitWidth":4,"label":"","connections":[136]},{"x":-20,"y":-50,"type":0,"bitWidth":1,"label":"","connections":[]},{"x":-10,"y":-50,"type":0,"bitWidth":1,"label":"","connections":[]},{"x":10,"y":-50,"type":0,"bitWidth":1,"label":"","connections":[]},{"x":20,"y":-50,"type":0,"bitWidth":1,"label":"","connections":[]},{"x":-20,"y":50,"type":0,"bitWidth":1,"label":"","connections":[]},{"x":-10,"y":50,"type":0,"bitWidth":1,"label":"","connections":[]},{"x":10,"y":50,"type":0,"bitWidth":1,"label":"","connections":[]},{"x":20,"y":5