irection":"UP","propagationDelay":0,"customData":{"nodes":{"output1":15},"constructorParamaters":["DOWN",12,"000000000000"]}},{"x":970,"y":380,"objectType":"ConstantVal","label":"","direction":"UP","labelDirection":"DOWN","propagationDelay":0,"customData":{"nodes":{"output1":24},"constructorParamaters":["UP",16,"0000001111101000"]}},{"x":1190,"y":120,"objectType":"ConstantVal","label":"","direction":"DOWN","labelDirection":"UP","propagationDelay":0,"customData":{"nodes":{"output1":42},"constructorParamaters":["DOWN",12,"000000000000"]}},{"x":1310,"y":380,"objectType":"ConstantVal","label":"","direction":"UP","labelDirection":"DOWN","propagationDelay":0,"customData":{"nodes":{"output1":47},"constructorParamaters":["UP",16,"0000000001100100"]}},{"x":1520,"y":120,"objectType":"ConstantVal","label":"","direction":"DOWN","labelDirection":"UP","propagationDelay":0,"customData":{"nodes":{"output1":68},"constructorParamaters":["DOWN",12,"000000000000"]}},{"x":1650,"y":380,"objectType":"ConstantVal","label":"","direction":"UP","labelDirection":"DOWN","propagationDelay":0,"customData":{"nodes":{"output1":72},"constructorParamaters":["UP",16,"0000000000001010"]}},{"x":1940,"y":120,"objectType":"ConstantVal","label":"","direction":"DOWN","labelDirection":"UP","propagationDelay":0,"customData":{"nodes":{"output1":85},"constructorParamaters":["DOWN",28,"0000000000000000000000000000"]}}],"SubCircuit":[{"x":680,"y":180,"id":"84671138937","label":"","labelDirection":"LEFT","inputNodes":[3,4],"outputNodes":[1,2],"version":"2.0"},{"x":990,"y":180,"id":"84671138937","label":"","labelDirection":"LEFT","inputNodes":[12,13],"outputNodes":[10,11],"version":"2.0"},{"x":1130,"y":440,"id":"78170471873","label":"","labelDirection":"LEFT","inputNodes":[31,32,33],"outputNodes":[29,30],"version":"2.0"},{"x":1330,"y":180,"id":"84671138937","label":"","labelDirection":"LEFT","inputNodes":[39,40],"outputNodes":[37,38],"version":"2.0"},{"x":1470,"y":430,"id":"78170471873","label":"","labelDirection":"LEFT","inputNodes":[53,54,55],"outputNodes":[51,52],"version":"2.0"},{"x":1670,"y":180,"id":"84671138937","label":"","labelDirection":"LEFT","inputNodes":[63,64],"outputNodes":[61,62],"version":"2.0"},{"x":1810,"y":420,"id":"78170471873","label":"","labelDirection":"LEFT","inputNodes":[76,77,78],"outputNodes":[74,75],"version":"2.0"},{"x":2070,"y":420,"id":"78170471873","label":"","labelDirection":"LEFT","inputNodes":[89,90,91],"outputNodes":[87,88],"version":"2.0"}],"Text":[{"x":500,"y":400,"objectType":"Text","label":"10000 dec","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["10000 dec",14]}},{"x":940,"y":400,"objectType":"Text","label":"1000 dec","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["1000 dec",14]}},{"x":1290,"y":400,"objectType":"Text","label":"100 dec","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["100 dec",14]}},{"x":1630,"y":400,"objectType":"Text","label":"10 dec","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["10 dec",14]}},{"x":-570,"y":-250,"objectType":"Text","label":"### Circuito per la conversione da 5 cifre BCD al corrispondente numero binario\n\nIl circuito realizza la conversione di un numero composto da **5 cifre BCD** nel corrispondente valore **binario**.\n\nLa conversione viene effettuata utilizzando **quattro moduli collegati in cascata**. Ciascun modulo converte una cifra BCD in binario e la moltiplica per il **peso decimale corrispondente alla posizione della cifra**.\n\nIn particolare:\n\n* la cifra più significativa viene moltiplicata per **10000**;\n* la seconda cifra per **1000**;\n* la terza cifra per **100**;\n* la quarta cifra per **10**;\n* la cifra delle unità viene utilizzata direttamente, senza moltiplicazione.\n\nLe uscite dei quattro moduli, insieme al valore della cifra delle unità, vengono infine sommate mediante un **addizionatore a 32 bit**.\n\nLa somma dei valori ottenuti fornisce il **corrispondente numero binario a 32 bit**.\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["### Circuito per la conversione da 5 cifre BCD al corrispondente numero binario\n\nIl circuito realizza la conversione di un numero composto da **5 cifre BCD** nel corrispondente valore **binario**.\n\nLa conversione viene effettuata utilizzando **quattro moduli collegati in cascata**. Ciascun modulo converte una cifra BCD in binario e la moltiplica per il **peso decimale corrispondente alla posizione della cifra**.\n\nIn particolare:\n\n* la cifra più significativa viene moltiplicata per **10000**;\n* la seconda cifra per **1000**;\n* la terza cifra per **100**;\n* la quarta cifra per **10**;\n* la cifra delle unità viene utilizzata direttamente, senza moltiplicazione.\n\nLe uscite dei quattro moduli, insieme al valore della cifra delle unità, vengono infine sommate mediante un **addizionatore a 32 bit**.\n\nLa somma dei valori ottenuti fornisce il **corrispondente numero binario a 32 bit**.\n",14]}},{"x":1490,"y":-230,"objectType":"Text","label":"### Circuit for converting 5 BCD digits into the corresponding binary number\n\nThe circuit converts a number consisting of **5 BCD digits** into its corresponding **binary** value.\n\nThe conversion is performed using **four modules connected in cascade**. Each module converts one BCD digit into binary and multiplies it by the **decimal weight corresponding to the digit's position**.\n\nSpecifically:\n\n* the most significant digit is multiplied by **10000**;\n* the second digit by **1000**;\n* the third digit by **100**;\n* the fourth digit by **10**;\n* the units digit is used directly, without multiplication.\n\nThe outputs of the four modules, together with the value of the units digit, are then added using a **32-bit adder**.\n\nThe resulting sum represents the **corresponding 32-bit binary number**.\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["### Circuit for converting 5 BCD digits into the corresponding binary number\n\nThe circuit converts a number consisting of **5 BCD digits** into its corresponding **binary** value.\n\nThe conversion is performed using **four modules connected in cascade**. Each module converts one BCD digit into binary and multiplies it by the **decimal weight corresponding to the digit's position**.\n\nSpecifically:\n\n* the most significant digit is multiplied by **10000**;\n* the second digit by **1000**;\n* the third digit by **100**;\n* the fourth digit by **10**;\n* the units digit is used directly, without multiplication.\n\nThe outputs of the four modules, together with the value of the units digit, are then added using a **32-bit adder**.\n\nThe resulting sum represents the **corresponding 32-bit binary number**.\n",14]}}],"restrictedCircuitElementsUsed":[],"nodes":[14,20,21,22,23,25,26,27,28,34,36,46,48,49,50,56,57,58,59,60,70,71,73,79,80,81,82,83,84,92,96,97,98,99,100,101,103,104,125,144,145,146,147,148,149,150,151,152,153,154,155,156,157,158,159,160,161,162,163,164,165,166,167,168,169,170,171,176]},{"layout":{"width":100,"height":80,"title_x":50,"title_y":13,"titleEnabled":true},"verilogMetadata":{"isVerilogCircuit":false,"isMainCircuit":false,"code":"// Write Some Verilog Code Here!","subCircuitScopeIds":[]},"allNodes":[{"x":-20,"y":10,"type":0,"bitWidth":1,"label":"Clock","connections":[519]},{"x":-20,"y":-10,"type":0,"bitWidth":1,"label":"D","connections":[469]},{"x":20,"y":-10,"type":1,"bitWidth":1,"label":"Q","connections":[604]},{"x":20,"y":10,"type":1,"bitWidth":1,"label":"Q Inverse","connections":[]},{"x":10,"y":20,"type":0,"bitWidth":1,"label":"Asynchronous Reset","connections":[243]},{"x":0,"y":20,"type":0,"bitWidth":1,"label":"Preset","connections":[]},{"x":-10,"y":20,"type":0,"bitWidth":1,"label":"Enable","connection