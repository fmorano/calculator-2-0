[240,241,242],"outputNodes":[243,244],"version":"2.0"},{"x":1210,"y":450,"id":"78170471873","label":"","labelDirection":"LEFT","inputNodes":[262,263,264],"outputNodes":[265,266],"version":"2.0"},{"x":1390,"y":450,"id":"78170471873","label":"","labelDirection":"LEFT","inputNodes":[272,273,274],"outputNodes":[275,276],"version":"2.0"},{"x":1570,"y":450,"id":"78170471873","label":"","labelDirection":"LEFT","inputNodes":[282,283,284],"outputNodes":[285,286],"version":"2.0"},{"x":1750,"y":450,"id":"78170471873","label":"","labelDirection":"LEFT","inputNodes":[291,292,293],"outputNodes":[294,295],"version":"2.0"},{"x":1930,"y":450,"id":"78170471873","label":"","labelDirection":"LEFT","inputNodes":[301,302,303],"outputNodes":[304,305],"version":"2.0"},{"x":2110,"y":450,"id":"78170471873","label":"","labelDirection":"LEFT","inputNodes":[310,311,312],"outputNodes":[313,314],"version":"2.0"},{"x":2290,"y":450,"id":"78170471873","label":"","labelDirection":"LEFT","inputNodes":[319,320,321],"outputNodes":[322,323],"version":"2.0"},{"x":2470,"y":450,"id":"78170471873","label":"","labelDirection":"LEFT","inputNodes":[328,329,330],"outputNodes":[331,332],"version":"2.0"},{"x":2650,"y":450,"id":"78170471873","label":"","labelDirection":"LEFT","inputNodes":[338,339,340],"outputNodes":[341,342],"version":"2.0"},{"x":2830,"y":450,"id":"78170471873","label":"","labelDirection":"LEFT","inputNodes":[348,349,350],"outputNodes":[351,352],"version":"2.0"},{"x":3010,"y":450,"id":"78170471873","label":"","labelDirection":"LEFT","inputNodes":[357,358,359],"outputNodes":[360,361],"version":"2.0"},{"x":3190,"y":450,"id":"78170471873","label":"","labelDirection":"LEFT","inputNodes":[366,367,368],"outputNodes":[369,370],"version":"2.0"}],"Text":[{"x":0,"y":380,"objectType":"Text","label":"10001000011111110","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["10001000011111110",14]}},{"x":120,"y":-600,"objectType":"Text","label":"**Italiano:**\n\n**Moltiplicazione di numeri a 16 bit: A × B**\n\nIl prodotto viene calcolato mediante **16 addizioni parziali**.\nPer ogni stadio, gli ingressi dell’addizionatore sono costituiti dal risultato dell’addizionatore precedente e dal valore determinato dal corrispondente bit di **B**.\n\nSe il bit di **B** è **1**, viene fornito **A shiftato** in base alla posizione del bit considerato.\nSe il bit di **B** è **0**, viene invece fornito **0**.\n\nIl risultato finale delle 16 addizioni parziali corrisponde al prodotto **A × B**.\n\n**English:**\n\n**16-bit multiplication: A × B**\n\nThe product is calculated through **16 partial additions**.\nAt each stage, the inputs of the adder are the output of the previous adder and the value determined by the corresponding bit of **B**.\n\nIf the bit of **B** is **1**, **A shifted according to the position of the bit** is provided.\nIf the bit of **B** is **0**, **0** is provided instead.\n\nThe final result of the 16 partial additions corresponds to the product **A × B**.\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["**Italiano:**\n\n**Moltiplicazione di numeri a 16 bit: A × B**\n\nIl prodotto viene calcolato mediante **16 addizioni parziali**.\nPer ogni stadio, gli ingressi dell’addizionatore sono costituiti dal risultato dell’addizionatore precedente e dal valore determinato dal corrispondente bit di **B**.\n\nSe il bit di **B** è **1**, viene fornito **A shiftato** in base alla posizione del bit considerato.\nSe il bit di **B** è **0**, viene invece fornito **0**.\n\nIl risultato finale delle 16 addizioni parziali corrisponde al prodotto **A × B**.\n\n**English:**\n\n**16-bit multiplication: A × B**\n\nThe product is calculated through **16 partial additions**.\nAt each stage, the inputs of the adder are the output of the previous adder and the value determined by the corresponding bit of **B**.\n\nIf the bit of **B** is **1**, **A shifted according to the position 