":["RIGHT",1]}},{"x":3110,"y":1040,"objectType":"DflipFlop","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"nodes":{"clockInp":813,"dInp":814,"qOutput":815,"qInvOutput":816,"reset":817,"preset":818,"en":819},"constructorParamaters":["RIGHT",1]}},{"x":2510,"y":850,"objectType":"DflipFlop","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"nodes":{"clockInp":939,"dInp":940,"qOutput":941,"qInvOutput":942,"reset":943,"preset":944,"en":945},"constructorParamaters":["RIGHT",1]}}],"Clock":[{"x":290,"y":570,"objectType":"Clock","label":"","direction":"UP","labelDirection":"DOWN","propagationDelay":0,"customData":{"nodes":{"output1":571},"constructorParamaters":["UP"]}}],"Button":[{"x":240,"y":480,"objectType":"Button","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":0,"customData":{"nodes":{"output1":964},"values":{"state":0},"constructorParamaters":["RIGHT",1]},"subcircuitMetadata":{"showInSubcircuit":false,"showLabelInSubcircuit":true,"labelDirection":"LEFT","x":0,"y":0}}],"ALU":[{"x":1750,"y":720,"objectType":"ALU","label":"","direction":"DOWN","labelDirection":"UP","propagationDelay":10,"customData":{"constructorParamaters":["DOWN",16],"nodes":{"inp1":622,"inp2":623,"output":626,"carryOut":625,"controlSignalInput":624}}},{"x":1750,"y":900,"objectType":"ALU","label":"","direction":"DOWN","labelDirection":"UP","propagationDelay":10,"customData":{"constructorParamaters":["DOWN",16],"nodes":{"inp1":649,"inp2":650,"output":653,"carryOut":652,"controlSignalInput":651}}}],"Counter":[{"x":2420,"y":850,"objectType":"Counter","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"nodes":{"maxValue":934,"clock":935,"reset":936,"output":937,"zero":938},"constructorParamaters":[4]},"subcircuitMetadata":{"showInSubcircuit":false,"showLabelInSubcircuit":true,"labelDirection":"LEFT","x":0,"y":0}}],"Text":[{"x":-330,"y":-500,"objectType":"Text","label":"### Divisione a 16 bit\n\nIl circuito implementa la **divisione binaria a 16 bit**, secondo la relazione:\n\n**D = Q × d + R**\n\ndove **D** è il dividendo, **d** il divisore, **Q** il quoziente e **R** il resto.\n\nIl circuito è realizzato come una **semplice estensione della divisione a 4 bit**, mantenendo lo stesso principio di funzionamento e aumentando la dimensione dei registri e il numero di bit elaborati.\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["### Divisione a 16 bit\n\nIl circuito implementa la **divisione binaria a 16 bit**, secondo la relazione:\n\n**D = Q × d + R**\n\ndove **D** è il dividendo, **d** il divisore, **Q** il quoziente e **R** il resto.\n\nIl circuito è realizzato come una **semplice estensione della divisione a 4 bit**, mantenendo lo stesso principio di funzionamento e aumentando la dimensione dei registri e il numero di bit elaborati.\n",14]}},{"x":1960,"y":-480,"objectType":"Text","label":"### 16-bit Division\n\nThe circuit implements **16-bit binary division**, according to the following relation:\n\n**D = Q × d + R**\n\nwhere **D** is the dividend, **d** is the divisor, **Q** is the quotient, and **R** is the remainder.\n\nThe circuit is implemented as a **straightforward extension of the 4-bit division circuit**, using the same operating principle while increasing the register sizes and the number of bits processed.\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["### 16-bit Division\n\nThe circuit implements **16-bit binary division**, according to the following relation:\n\n**D = Q × d + R**\n\nwhere **D** is the dividend, **d** is the divisor, **Q** is the quotient, and **R** is the remainder.\n\nThe circuit is implemented as a **straightforward extension of the 4-bit division circuit**, using the same operating principle while increasing the register sizes and the number of bits processed.\n",