uctorParamaters":["RIGHT",1]}},{"x":1570,"y":160,"objectType":"DflipFlop","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"nodes":{"clockInp":44,"dInp":45,"qOutput":46,"qInvOutput":47,"reset":48,"preset":49,"en":50},"constructorParamaters":["RIGHT",1]}},{"x":1690,"y":160,"objectType":"DflipFlop","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"nodes":{"clockInp":51,"dInp":52,"qOutput":53,"qInvOutput":54,"reset":55,"preset":56,"en":57},"constructorParamaters":["RIGHT",1]}}],"Text":[{"x":870,"y":-590,"objectType":"Text","label":"**Italiano**\n\n**Operazione di Load o Shift a 8 bit**\n\nL’operazione viene determinata dal valore del segnale **L**:\n\n* **L = 0:** al segnale di clock, il circuito carica l’input nel registro.\n* **L = 1:** al segnale di clock, il circuito esegue uno **shift a sinistra di una posizione**.\n\n**English**\n\n**8-bit Load or Shift operation**\n\nThe operation is determined by the value of the **L** signal:\n\n* **L = 0:** on the clock signal, the circuit loads the input into the register.\n* **L = 1:** on the clock signal, the circuit performs a **one-position left shift**.\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["**Italiano**\n\n**Operazione di Load o Shift a 8 bit**\n\nL’operazione viene determinata dal valore del segnale **L**:\n\n* **L = 0:** al segnale di clock, il circuito carica l’input nel registro.\n* **L = 1:** al segnale di clock, il circuito esegue uno **shift a sinistra di una posizione**.\n\n**English**\n\n**8-bit Load or Shift operation**\n\nThe operation is determined by the value of the **L** signal:\n\n* **L = 0:** on the clock signal, the circuit loads the input into the register.\n* **L = 1:** on the clock signal, the circuit performs a **one-position left shift**.\n",14]}}],"restrictedCircuitElementsUsed":[],"nodes":[63,75,80,89,94,99,104,105,106,107,108,109,110,111,112,