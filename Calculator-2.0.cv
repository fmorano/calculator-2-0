kInp":76,"dInp":77,"qOutput":78,"qInvOutput":79,"reset":80,"preset":81,"en":82},"constructorParamaters":["RIGHT",1]}},{"x":1010,"y":310,"objectType":"DflipFlop","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"nodes":{"clockInp":83,"dInp":84,"qOutput":85,"qInvOutput":86,"reset":87,"preset":88,"en":89},"constructorParamaters":["RIGHT",1]}},{"x":1090,"y":310,"objectType":"DflipFlop","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"nodes":{"clockInp":90,"dInp":91,"qOutput":92,"qInvOutput":93,"reset":94,"preset":95,"en":96},"constructorParamaters":["RIGHT",1]}},{"x":1170,"y":310,"objectType":"DflipFlop","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"nodes":{"clockInp":97,"dInp":98,"qOutput":99,"qInvOutput":100,"reset":101,"preset":102,"en":103},"constructorParamaters":["RIGHT",1]}},{"x":330,"y":270,"objectType":"DflipFlop","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"nodes":{"clockInp":205,"dInp":206,"qOutput":207,"qInvOutput":208,"reset":209,"preset":210,"en":211},"constructorParamaters":["RIGHT",1]}},{"x":1220,"y":810,"objectType":"DflipFlop","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"nodes":{"clockInp":221,"dInp":222,"qOutput":223,"qInvOutput":224,"reset":225,"preset":226,"en":227},"constructorParamaters":["RIGHT",1]}},{"x":1300,"y":810,"objectType":"DflipFlop","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"nodes":{"clockInp":228,"dInp":229,"qOutput":230,"qInvOutput":231,"reset":232,"preset":233,"en":234},"constructorParamaters":["RIGHT",1]}},{"x":1380,"y":810,"objectType":"DflipFlop","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"nodes":{"clockInp":235,"dInp":236,"qOutput":237,"qInvOutput":238,"reset":239,"preset":240,"en":241},"constructorParamaters":["RIGHT",1]}},{"x":1460,"y":810,"objectType":"DflipFlop","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"nodes":{"clockInp":242,"dInp":243,"qOutput":244,"qInvOutput":245,"reset":246,"preset":247,"en":248},"constructorParamaters":["RIGHT",1]}},{"x":1450,"y":580,"objectType":"DflipFlop","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"nodes":{"clockInp":295,"dInp":296,"qOutput":297,"qInvOutput":298,"reset":299,"preset":300,"en":301},"constructorParamaters":["RIGHT",1]}}],"Clock":[{"x":120,"y":750,"objectType":"Clock","label":"clock","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":0,"customData":{"nodes":{"output1":219},"constructorParamaters":["RIGHT"]}}],"DigitalLed":[{"x":1730,"y":1000,"objectType":"DigitalLed","label":"","direction":"UP","labelDirection":"DOWN","propagationDelay":10,"customData":{"constructorParamaters":["Red"],"nodes":{"inp1":264}},"subcircuitMetadata":{"showInSubcircuit":false,"showLabelInSubcircuit":true,"labelDirection":"DOWN","x":0,"y":0}}],"ALU":[{"x":730,"y":560,"objectType":"ALU","label":"","direction":"DOWN","labelDirection":"UP","propagationDelay":10,"customData":{"constructorParamaters":["DOWN",4],"nodes":{"inp1":37,"inp2":38,"output":41,"carryOut":40,"controlSignalInput":39}}},{"x":750,"y":700,"objectType":"ALU","label":"","direction":"DOWN","labelDirection":"UP","propagationDelay":10,"customData":{"constructorParamaters":["DOWN",4],"nodes":{"inp1":48,"inp2":49,"output":52,"carryOut":51,"controlSignalInput":50}}}],"Counter":[{"x":1360,"y":580,"objectType":"Counter","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"nodes":{"maxValue":265,"clock":266,"reset":267,"output":268,"zero":269},"constructorParamaters":[2]},"subcircuitMetadata":{"showInSubcircuit":false,"showLabelInSubcircuit":true,"labelDirection":"LEFT","x":0,"y":0}}],"Text":[{"x":-980,"y":-150,"objectType":"Text","label":"### Divisione a 4 bit\n\nIl circuito implementa la **divisione binaria a 4 bit**, seguendo un procedimento analogo a quello della tradizionale **divisione in colonna** utilizzata per i numeri decimali.\n\nIl **registro del resto**, posto nella parte superiore sinistra del circuito, contiene il resto parziale della divisione. Alla sua destra si trova il registro del **dividendo (D)**.\n\nAd ogni ciclo di elaborazione, il resto viene **shiftato a sinistra** e viene inserito il bit più significativo successivo del dividendo. Il valore ottenuto viene quindi confrontato con il **divisore (d)**:\n\n* se il resto è **maggiore o uguale al divisore**, il divisore viene sottratto dal resto e viene generato un bit del quoziente pari a **1**;\n* se il resto è **minore del divisore**, il resto rimane invariato e viene generato un bit del quoziente pari a **0**.\n\nLa procedura viene ripetuta fino a quando sono stati elaborati tutti i **quattro bit del dividendo**.\n\nIl **flip-flop posto accanto al contatore, nella parte inferiore destra**, ha il compito di segnalare il completamento dell'operazione dopo i quattro cicli di elaborazione.\n\nIl **flip-flop configurato in modalità toggle**, situato nella parte superiore sinistra, gestisce invece l'alternanza tra le due sottofasi di ciascun ciclo di clock.\n\nNella **prima sottofase**, il multiplexer seleziona il percorso necessario per eseguire lo **shift a sinistra del resto** e acquisire il bit successivo del dividendo.\n\nNella **seconda sottofase**, il multiplexer seleziona il nuovo valore del resto, ottenuto dopo l'eventuale sottrazione del divisore.\n\nIn questo modo, ogni ciclo di clock viene suddiviso in **due operazioni distinte**: prima l'acquisizione del nuovo bit del dividendo e successivamente l'aggiornamento del resto.\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["### Divisione a 4 bit\n\nIl circuito implementa la **divisione binaria a 4 bit**, seguendo un procedimento analogo a quello della tradizionale **divisione in colonna** utilizzata per i numeri decimali.\n\nIl **registro del resto**, posto nella parte superiore sinistra del circuito, contiene il resto parziale della divisione. Alla sua destra si trova il registro del **dividendo (D)**.\n\nAd ogni ciclo di elaborazione, il resto viene **shiftato a sinistra** e viene inserito il bit più significativo successivo del dividendo. Il valore ottenuto viene quindi confrontato con il **divisore (d)**:\n\n* se il resto è **maggiore o uguale al divisore**, il divisore viene sottratto dal resto e viene generato un bit del quoziente pari a **1**;\n* se il resto è **minore del divisore**, il resto rimane invariato e viene generato un bit del quoziente pari a **0**.\n\nLa procedura viene ripetuta fino a quando sono stati elaborati tutti i **quattro bit del dividendo**.\n\nIl **flip-flop posto accanto al contatore, nella parte inferiore destra**, ha il compito di segnalare il completamento dell'operazione dopo i quattro cicli di elaborazione.\n\nIl **flip-flop configurato in modalità toggle**, situato nella parte superiore sinistra, gestisce invece l'alternanza tra le due sottofasi di ciascun ciclo di clock.\n\nNella **prima sottofase**, il multiplexer seleziona il percorso necessario per eseguire lo **shift a sinistra del resto** e acquisire il bit successivo del dividendo.\n\nNella **seconda sottofase**, il multiplexer seleziona il nuovo valore del resto, ottenuto dopo l'eventuale sottrazione del divisore.\n\nIn questo modo, ogni ciclo di clock viene suddiviso in **due operazioni distinte**: prima l'acquisizione del nuovo bit del dividendo e successivamente l'aggiornamento del resto.\n",14]}},{"x":1330,"y":-160,"objectType":"Text","label":"### 4-bit Division\n\nThe circuit implements **4-bit binary division**, following a procedure similar to the traditional **long division** method used for decimal numbers.\n\nThe **remainder register**, located in the upper-left part of the circuit, stores the partial remainder of the division. To its right is the **dividend (D) register**.\n\nAt each processing cycle, the remainder is **shifted to the left**, and the next most significant bit of the dividend is inserted. The resulting value is then compared with the **divisor (d)**:\n\n* if the remainder is **greater than or equal to the divisor**, the divisor is subtracted from the remainder and a **1** is generated as the corresponding quotient bit;\n* if the remainder is **smaller than the divisor**, the remainder remains unchanged and a **0** is generated as the corresponding quotient bit.\n\nThis procedure is repeated until all **four bits of the dividend** have been processed.\n\nThe **flip-flop located next to the counter, in the lower-right part of the circuit**, signals the completion of the operation after the four processing cycles.\n\nThe **toggle-configured flip-flop**, located in the upper-left part of the circuit, controls the alternation between the two sub-phases of each clock cycle.\n\nDuring the **first sub-phase**, the multiplexer selects the path required to perform the **left shift of the remainder** and acquire the next bit of the dividend.\n\nDuring the **second sub-phase**, the multiplexer selects the new remainder value, obtained after the possible subtraction of the divisor.\n\nIn this way, each clock cycle is divided into **two distinct operations**: first, the acquisition of the next dividend bit, and then the updating of the remainder.\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["### 4-bit Division\n\nThe circuit implements **4-bit binary division**, following a procedure similar to the traditional **long division** method used for decimal numbers.\n\nThe **remainder register**, located in the upper-left part of the circuit, stores the partial remainder of the division. To its right is the **dividend (D) register**.\n\nAt each processing cycle, the remainder is **shifted to the left**, and the next most significant bit of the dividend is inserted. The resulting value is then compared with the **divisor (d)**:\n\n* if the remainder is **greater than or equal to the divisor**, the divisor is subtracted from the remainder and a **1** is generated as the corresponding quotient bit;\n* if the remainder is **smaller than the divisor**, the remainder remains unchanged and a **0** is generated as the corresponding quotient bit.\n\nThis procedure is repeated until all **four bits of the dividend** have been processed.\n\nThe **flip-flop located next to the counter, in the lower-right part of the circuit**, signals the completion of the operation after the four processing cycles.\n\nThe **toggle-configured flip-flop**, located in the upper-left part of the circuit, controls the alternation between the two sub-phases of each clock cycle.\n\nDuring the **first sub-phase**, the multiplexer selects the path required to perform the **left shift of the remainder** and acquire the next bit of the dividend.\n\nDuring the **second sub-phase**, the multiplexer selects the new remainder value, obtained after the possible subtraction of the divisor.\n\nIn this way, each clock cycle is divided into **two distinct operations**: first, the acquisition of the next dividend bit, and then the updating of the remainder.\n",14]}}],"restrictedCircuitElementsUsed":[],"nodes":[33,34,35,36,43,44,45,46,47,54,55,56,57,68,69,70,71,74,75,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,138,139,140,141,146,147,152,153,154,155,160,165,166,167,168,169,170,171,172,173,174,175,176,177,178,179,180,181,182,183,184,185,186,187,188,189,190,191,192,193,194,195,196,197,201,202,203,204,212,213,214,215,216,217,218,220,249,250,251,252,253,254,255,256,259,260,261,262,263,270,271,272,273,278,279,280,281,287,288,290,291,292,294,302,303,304,305,306,307,308,314,315,316,317,318,319,320,321,322,323]},{"layout":{"width":100,"heigh