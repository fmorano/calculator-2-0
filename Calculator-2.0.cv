930},"values":{"identifier":"busy2"}}},{"x":2250,"y":1540,"objectType":"Tunnel","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["RIGHT",1,"wait"],"nodes":{"inp1":938},"values":{"identifier":"wait"}}}],"Text":[{"x":700,"y":670,"objectType":"Text","label":"Accumulator","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["Accumulator",14]}},{"x":310,"y":240,"objectType":"Text","label":"+","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["+",26]}},{"x":-250,"y":800,"objectType":"Text","label":"input","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["input",14]}},{"x":0,"y":850,"objectType":"Text","label":"start","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["start",14]}},{"x":520,"y":420,"objectType":"Text","label":"clear","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["clear",14]}},{"x":1190,"y":400,"objectType":"Text","label":"out_dec","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["out_dec",14]}},{"x":710,"y":470,"objectType":"Text","label":"sign","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["sign",14]}},{"x":1360,"y":1040,"objectType":"Text","label":"sign","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["sign",14]}},{"x":1360,"y":1070,"objectType":"Text","label":"decimal","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["decimal",14]}},{"x":1370,"y":1100,"objectType":"Text","label":"out","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["out",14]}},{"x":320,"y":280,"objectType":"Text","label":"x","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["x",14]}},{"x":-370,"y":730,"objectType":"Text","label":"op_+","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["op_+",14]}},{"x":-610,"y":430,"objectType":"Text","label":"+","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["+",14]}},{"x":-650,"y":490,"objectType":"Text","label":"x","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["x",14]}},{"x":130,"y":780,"objectType":"Text","label":"op_x","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["op_x",14]}},{"x":-1020,"y":100,"objectType":"Text","label":"'ugule'  attiva clear a quindi l'operazione di default (addizione)  per permettere  di ricaricare l'accumulatore e di continuare con le operazioni ","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["'ugule'  attiva clear a quindi l'operazione di default (addizione)  per permettere  di ricaricare l'accumulatore e di continuare con le operazioni ",14]}},{"x":290,"y":130,"objectType":"Text","label":"AC","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["AC",14]}},{"x":360,"y":120,"objectType":"Text","label":"7","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["7",20]}},{"x":410,"y":120,"objectType":"Text","label":"8","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["8",20]}},{"x":350,"y":240,"objectType":"Text","label":"4","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["4",20]}},{"x":410,"y":240,"objectType":"Text","label":"5","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["5",20]}},{"x":460,"y":240,"objectType":"Text","label":"6","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["6",20]}},{"x":350,"y":290,"objectType":"Text","label":"1","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["1",20]}},{"x":410,"y":290,"objectType":"Text","label":"2","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["2",20]}},{"x":490,"y":290,"objectType":"Text","label":"3","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["3",20]}},{"x":460,"y":120,"objectType":"Text","label":"9","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["9",20]}},{"x":350,"y":350,"objectType":"Text","label":"0","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["0",20]}},{"x":430,"y":350,"objectType":"Text","label":".dot","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":[".dot",20]}},{"x":490,"y":350,"objectType":"Text","label":"+/-","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["+/-",20]}},{"x":320,"y":330,"objectType":"Text","label":":","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":[":",26]}},{"x":310,"y":390,"objectType":"Text","label":"=","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["=",26]}},{"x":240,"y":70,"objectType":"Text","label":"KEYBOARD","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["KEYBOARD",28]}},{"x":-60,"y":-170,"objectType":"Text","label":"CALCULATOR 2.0","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["CALCULATOR 2.0",46]}},{"x":-520,"y":-800,"objectType":"Text","label":"**Italiano**\n\n**Unità aritmetica in virgola mobile con segno**\n\nCircuito che esegue le quattro operazioni aritmetiche in virgola mobile con segno:\n\n* **addizione**\n* **sottrazione**\n* **moltiplicazione**\n* **divisione**\n\n**English**\n\n**Signed floating-point arithmetic unit**\n\nCircuit that performs the four signed floating-point arithmetic operations:\n\n* **addition**\n* **subtraction**\n* **multiplication**\n* **division**\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["**Italiano**\n\n**Unità aritmetica in virgola mobile con segno**\n\nCircuito che esegue le quattro operazioni aritmetiche in virgola mobile con segno:\n\n* **addizione**\n* **sottrazione**\n* **moltiplicazione**\n* **divisione**\n\n**English**\n\n**Signed floating-point arithmetic unit**\n\nCircuit that performs the four signed floating-point arithmetic operations:\n\n* **addition**\n* **subtraction**\n* **multiplication**\n* **division**\n",24]}},{"x":-2690,"y":-140,"objectType":"Text","label":"Esempio di funzionamento: 42 × 35 =\n\nVediamo ora il funzionamento del circuito attraverso l'esempio:\n\n42 × 35 = 1470\n\nInserimento del primo operando: 42\n\nL'utente digita prima 4 e poi 2.\n\nLe cifre vengono convertite dal circuito BCD → BIN e il valore risultante viene memorizzato nel registro B. In questo momento B contiene quindi la rappresentazione binaria di 42.\n\nPoiché all'avvio è abilitata la visualizzazione dell'input, il valore presente in B viene inviato al display. L'utente vede quindi:\n\n42\n\nL'accumulatore A, invece, contiene ancora 0, perché non è stata ancora eseguita alcuna operazione.\n\nIl flag dell'operazione è inizialmente impostato sul valore \"+\". Di conseguenza viene abilitato il buffer three-state del modulo di addizione/sottrazione.\n\nIl modulo calcola quindi:\n\nA + B = 0 + 42 = 42\n\nIl risultato 42 è presente sul bus, ma non è ancora stato caricato nell'accumulatore.\n\nPressione del tasto ×\n\nL'utente preme quindi il tasto ×.\n\nLa pressione di un tasto relativo a un'operazione provoca diverse azioni.\n\nPer prima cosa, l'operazione selezionata viene memorizzata in un registro temporaneo delle operazioni. In questo caso viene memorizzato:\n\n×\n\nSuccessivamente viene attivato lo scheduler a due fasi.\n\nNella prima fase dello scheduler viene eseguito il LOAD: il valore presente sul bus, cioè 42, viene caricato nell'accumulatore A.\n\nA questo punto:\n\nA = 42\nB = 42\n\nNella seconda fase viene eseguito il CLEAR dell'input, quindi B viene azzerato:\n\nA = 42\nB = 0\n\nIl registro temporaneo contiene ancora l'operazione × e questa viene successivamente trasferita nel registro del flag delle operazioni.\n\nL'accumulatore contiene quindi il primo operando e il circuito è pronto per ricevere il secondo.\n\nÈ importante notare che il valore visualizzato sul display non cambia necessariamente in questo momento: il display continua a mostrare il valore previsto dalla logica di visualizzazione, mentre il bus viene utilizzato internamente per il trasferimento dei dati.\n\nInserimento del secondo operando: 35\n\nLa pressione delle cifre 3 e 5 riattiva la fase di input.\n\nL'accumulatore A rimane invariato:\n\nA = 42\n\nAd ogni pressione della tastiera cambia invece il contenuto di B.\n\nAl termine dell'inserimento, B contiene la rappresentazione binaria di 35:\n\n35₁₀ = 100011₂\n\nIl display continua a mostrare il valore inserito dall'utente attraverso la conversione BIN → BCD.\n\nPressione del tasto =\n\nQuando l'utente preme =, viene nuovamente attivata la seconda fase del ciclo.\n\nIn questo caso non viene caricata una nuova operazione nel registro temporaneo: l'operazione memorizzata rimane infatti ×.\n\nIl registro del flag indica quindi che deve essere eseguita una moltiplicazione.\n\nIl modulo di moltiplicazione riceve:\n\nA = 42\nB = 35\n\ne produce sul bus il risultato:\n\n42 × 35 = 1470\n\nIl buffer three-state della moltiplicazione viene abilitato, mentre quelli degli altri moduli rimangono disabilitati.\n\nLo scheduler esegue quindi il LOAD del risultato nell'accumulatore:\n\nA = 1470\n\nSuccessivamente il display viene configurato per visualizzare l'output. Il valore binario contenuto nell'accumulatore viene convertito dal circuito BIN → BCD e visualizzato in formato decimale:\n\n1470\n\nA questo punto il valore di A rappresenta il risultato dell'operazione e può diventare il punto di partenza per un nuovo calcolo.\n\nAd esempio, l'utente può continuare a eseguire altre operazioni utilizzando 1470, che rimane memorizzato nell'accumulatore.\n\n\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["Esempio di funzionamento: 42 × 35 =\n\nVediamo ora il funzionamento del circuito attraverso l'esempio:\n\n42 × 35 = 1470\n\nInserimento del primo operando: 42\n\nL'utente digita prima 4 e poi 2.\n\nLe cifre vengono convertite dal circuito BCD → BIN e il valore risultante viene memorizzato nel registro B. In questo momento B contiene quindi la rappresentazione binaria di 42.\n\nPoiché all'avvio è abilitata la visualizzazione dell'input, il valore presente in B viene inviato al display. L'utente vede quindi:\n\n42\n\nL'accumulatore A, invece, contiene ancora 0, perché non è stata ancora eseguita alcuna operazione.\n\nIl flag dell'operazione è inizialmente impostato sul valore \"+\". Di conseguenza viene abilitato il buffer three-state del modulo di addizione/sottrazione.\n\nIl modulo calcola quindi:\n\nA + B = 0 + 42 = 42\n\nIl risultato 42 è presente sul bus, ma non è ancora stato caricato nell'accumulatore.\n\nPressione del tasto ×\n\nL'utente preme quindi il tasto ×.\n\nLa pressione di un tasto relativo a un'operazione provoca diverse azioni.\n\nPer prima cosa, l'operazione selezionata viene memorizzata in un registro temporaneo delle operazioni. In questo caso viene memorizzato:\n\n×\n\nSuccessivamente viene attivato lo scheduler a due fasi.\n\nNella prima fase dello scheduler viene eseguito il LOAD: il valore presente sul bus, cioè 42, viene caricato nell'accumulatore A.\n\nA questo punto:\n\nA = 42\nB = 42\n\nNella seconda fase viene eseguito il CLEAR dell'input, quindi B viene azzerato:\n\nA = 42\nB = 0\n\nIl registro temporaneo contiene ancora l'operazione × e questa viene successivamente trasferita nel registro del flag delle operazioni.\n\nL'accumulatore contiene quindi il primo operando e il circuito è pronto per ricevere il secondo.\n\nÈ importante notare che il valore visualizzato sul display non cambia necessariamente in questo momento: il display continua a mostrare il valore previsto dalla logica di visualizzazione, mentre il bus viene utilizzato internamente per il trasferimento dei dati.\n\nInserimento del secondo operando: 35\n\nLa pressione delle cifre 3 e 5 riattiva la fase di input.\n\nL'accumulatore A rimane invariato:\n\nA = 42\n\nAd ogni pressione della tastiera cambia invece il contenuto di B.\n\nAl termine dell'inserimento, B contiene la rappresentazione binaria di 35:\n\n35₁₀ = 100011₂\n\nIl display continua a mostrare il valore inserito dall'utente attraverso la conversione BIN → BCD.\n\nPressione del tasto =\n\nQuando l'utente preme =, viene nuovamente attivata la seconda fase del ciclo.\n\nIn questo caso non viene caricata una nuova operazione nel registro temporaneo: l'operazione memorizzata rimane infatti ×.\n\nIl registro del flag indica quindi che deve essere eseguita una moltiplicazione.\n\nIl modulo di moltiplicazione riceve:\n\nA = 42\nB = 35\n\ne produce sul bus il risultato:\n\n42 × 35 = 1470\n\nIl buffer three-state della moltiplicazione viene abilitato, mentre quelli degli altri moduli rimangono disabilitati.\n\nLo scheduler esegue quindi il LOAD del risultato nell'accumulatore:\n\nA = 1470\n\nSuccessivamente il display viene configurato per visualizzare l'output. Il valore binario contenuto nell'accumulatore viene convertito dal circuito BIN → BCD e visualizzato in formato decimale:\n\n1470\n\nA questo punto il valore di A rappresenta il risultato dell'operazione e può diventare il punto di partenza per un nuovo calcolo.\n\nAd esempio, l'utente può continuare a eseguire altre operazioni utilizzando 1470, che rimane memorizzato nell'accumulatore.\n\n\n",14]}},{"x":2460,"y":-620,"objectType":"Text","label":"# Example of operation: 42 × 35 =\n\nLet's now look at how the circuit works using the following example:\n\n**42 × 35 = 1470**\n\n### Entering the first operand: 42\n\nThe user first enters **4** and then **2**.\n\nThe digits are converted by the **BCD → BIN** converter, and the resulting value is stored in register B. At this point, B therefore contains the binary representation of **42**.\n\nSince the input display is enabled by default, the value stored in B is sent to the display. The user therefore sees:\n\n**42**\n\nThe accumulator A, on the other hand, still contains **0**, because no operation has been performed yet.\n\nThe operation flag is initially set to **\"+\"**. As a result, the three-state buffer of the addition/subtraction module is enabled.\n\nThe module therefore calculates:\n\n**A + B = 0 + 42 = 42**\n\nThe result **42** is present on the bus, but it has not yet been loaded into the accumulator.\n\n---\n\n### Pressing the × key\n\nThe user then presses the **×** key.\n\nPressing an operation key triggers several actions.\n\nFirst, the selected operation is stored in a **temporary operation register**. In this case, the operation stored is:\n\n**×**\n\nThe **two-phase scheduler** is then activated.\n\nDuring the first phase of the scheduler, a **LOAD** operation is performed: the value currently present on the bus, which is **42**, is loaded into accumulator A.\n\nAt this point:\n\n* **A = 42**\n* **B = 42**\n\nDuring the second phase, the **input is cleared**, so B is reset:\n\n* **A = 42**\n* **B = 0**\n\nThe temporary operation register still contains the **×** operation, which is then transferred to the operation flag register.\n\nThe accumulator therefore contains the first operand, and the circuit is ready to receive the second operand.\n\nIt is important to note that the value shown on the display does not necessarily change at this point. The display continues to show the value determined by the display logic, while the bus is used internally to transfer the data.\n\n---\n\n### Entering the second operand: 35\n\nEntering the digits **3** and **5** activates the input phase again.\n\nThe accumulator A remains unchanged:\n\n**A = 42**\n\nOnly the value stored in B changes with each key press.\n\nAt the end of the input sequence, B contains the binary representation of **35**:\n\n**35₁₀ = 100011₂**\n\nThe display continues to show the value entered by the user through the **BIN → BCD** conversion.\n\n---\n\n### Pressing the = key\n\nWhen the user presses **=**, the second phase of the cycle is activated again.\n\nIn this case, no new operation is loaded into the temporary operation register: the previously stored operation remains **×**.\n\nThe operation flag therefore indicates that a multiplication must be performed.\n\nThe multiplication module receives:\n\n* **A = 42**\n* **B = 35**\n\nand produces the result on the bus:\n\n**42 × 35 = 1470**\n\nThe three-state buffer of the multiplication module is enabled, while the buffers of the other operation modules remain disabled.\n\nThe scheduler then performs a **LOAD** operation, transferring the result into the accumulator:\n\n**A = 1470**\n\nThe display is then configured to show the **output**. The binary value stored in the accumulator is converted by the **BIN → BCD** converter and displayed in decimal format:\n\n**1470**\n\nAt this point, the value stored in A represents the result of the operation and can be used as the starting point for a new calculation.\n\nFor example, the user can continue performing additional operations using **1470**, which remains stored in the accumulator.\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["# Example of operation: 42 × 35 =\n\nLet's now look at how the circuit works using the following example:\n\n**42 × 35 = 1470**\n\n### Entering the first operand: 42\n\nThe user first enters **4** and then **2**.\n\nThe digits are converted by the **BCD → BIN** converter, and the resulting value is stored in register B. At this point, B therefore contains the binary representation of **42**.\n\nSince the input display is enabled by default, the value stored in B is sent to the display. The user therefore sees:\n\n**42**\n\nThe accumulator A, on the other hand, still contains **0**, because no operation has been performed yet.\n\nThe operation flag is initially set to **\"+\"**. As a result, the three-state buffer of the addition/subtraction module is enabled.\n\nThe module therefore calculates:\n\n**A + B = 0 + 42 = 42**\n\nThe result **42** is present on the bus, but it has not yet been loaded into the accumulator.\n\n---\n\n### Pressing the × key\n\nThe user then presses the **×** key.\n\nPressing an operation key triggers several actions.\n\nFirst, the selected operation is stored in a **temporary operation register**. In this case, the operation stored is:\n\n**×**\n\nThe **two-phase scheduler** is then activated.\n\nDuring the first phase of the scheduler, a **LOAD** operation is performed: the value currently present on the bus, which is **42**, is loaded into accumulator A.\n\nAt this point:\n\n* **A = 42**\n* **B = 42**\n\nDuring the second phase, the **input is cleared**, so B is reset:\n\n* **A = 42**\n* **B = 0**\n\nThe temporary operation register still contains the **×** operation, which is then transferred to the operation flag register.\n\nThe accumulator therefore contains the first operand, and the circuit is ready to receive the second operand.\n\nIt is important to note that the value shown on the display does not necessarily change at this point. The display continues to show the value determined by the display logic, while the bus is used internally to transfer the data.\n\n---\n\n### Entering the second operand: 35\n\nEntering the digits **3** and **5** activates the input phase again.\n\nThe accumulator A remains unchanged:\n\n**A = 42**\n\nOnly the value stored in B changes with each key press.\n\nAt the end of the input sequence, B contains the binary representation of **35**:\n\n**35₁₀ = 100011₂**\n\nThe display continues to show the value entered by the user through the **BIN → BCD** conversion.\n\n---\n\n### Pressing the = key\n\nWhen the user presses **=**, the second phase of the cycle is activated again.\n\nIn this case, no new operation is loaded into the temporary operation register: the previously stored operation remains **×**.\n\nThe operation flag therefore indicates that a multiplication must be performed.\n\nThe multiplication module receives:\n\n* **A = 42**\n* **B = 35**\n\nand produces the result on the bus:\n\n**42 × 35 = 1470**\n\nThe three-state buffer of the multiplication module is enabled, while the buffers of the other operation modules remain disabled.\n\nThe scheduler then performs a **LOAD** operation, transferring the result into the accumulator:\n\n**A = 1470**\n\nThe display is then configured to show the **output**. The binary value stored in the accumulator is converted by the **BIN → BCD** converter and displayed in decimal format:\n\n**1470**\n\nAt this point, the value stored in A represents the result of the operation and can be used as the starting point for a new calculation.\n\nFor example, the user can continue performing additional operations using **1470**, which remains stored in the accumulator.\n",14]}},{"x":1090,"y":370,"objectType":"Text","label":"B","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["B",14]}},{"x":750,"y":590,"objectType":"Text","label":"A","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["A",14]}},{"x":770,"y":540,"objectType":"Text","label":"B sign","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["B sign",14]}},{"x":680,"y":880,"objectType":"Text","label":"Accumulator Sign","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["Accumulator Sign",14]}},{"x":880,"y":690,"objectType":"Text","label":"a_dec","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["a_dec",14]}},{"x":440,"y":1040,"objectType":"Text","label":"BUS","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["BUS",26]}},{"x":1300,"y":-700,"objectType":"Text","label":"DISPLAY BUS","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["DISPLAY BUS",30]}},{"x":1610,"y":1150,"objectType":"Text","label":"overlow","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["overlow",14]}},{"x":160,"y":110,"objectType":"Text","label":"press AC button\nto start","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["press AC button\nto start",14]}}],"Rectangle":[{"x":260,"y":120,"objectType":"Rectangle","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":[30,28]}}],"Arrow":[{"x":220,"y":150,"objectType":"Arrow","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["RIGHT"]}},{"x":470,"y":1070,"objectType":"Arrow","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"cons