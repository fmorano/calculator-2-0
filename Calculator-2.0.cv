des":{"output1":237},"constructorParamaters":["DOWN",4,"0000"]}}],"Demultiplexer":[{"x":-290,"y":320,"objectType":"Demultiplexer","label":"","direction":"LEFT","labelDirection":"RIGHT","propagationDelay":10,"customData":{"constructorParamaters":["LEFT",4,1],"nodes":{"output1":[141,142],"input":140,"controlSignalInput":143}}}],"SubCircuit":[{"x":610,"y":430,"id":"97609001411","label":"","labelDirection":"LEFT","inputNodes":[1,2,3,4,5,6,7,8,9],"outputNodes":[0],"version":"2.0"},{"x":1100,"y":190,"id":"78170471873","label":"","labelDirection":"LEFT","inputNodes":[17,18,19],"outputNodes":[15,16],"version":"2.0"},{"x":700,"y":-420,"id":"97609001411","label":"","labelDirection":"LEFT","inputNodes":[25,26,27,28,29,30,31,32,33],"outputNodes":[24],"version":"2.0"},{"x":1100,"y":500,"id":"46914933285","label":"","labelDirection":"LEFT","inputNodes":[45,46],"outputNodes":[43,44],"version":"2.0"},{"x":-540,"y":190,"id":"46914933285","label":"","labelDirection":"LEFT","inputNodes":[116,117],"outputNodes":[114,115],"version":"2.0"},{"x":910,"y":270,"id":"24352196407","label":"","labelDirection":"LEFT","inputNodes":[158,159],"outputNodes":[156,157],"version":"2.0"},{"x":900,"y":-30,"id":"24352196407","label":"","labelDirection":"LEFT","inputNodes":[162,163],"outputNodes":[160,161],"version":"2.0"}],"Tunnel":[{"x":1710,"y":280,"objectType":"Tunnel","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["RIGHT",1,"O"],"nodes":{"inp1":231},"values":{"identifier":"O"}}},{"x":-600,"y":520,"objectType":"Tunnel","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["RIGHT",1,"O"],"nodes":{"inp1":232},"values":{"identifier":"O"}}}],"ALU":[{"x":-840,"y":300,"objectType":"ALU","label":"","direction":"DOWN","labelDirection":"UP","propagationDelay":10,"customData":{"constructorParamaters":["DOWN",4],"nodes":{"inp1":181,"inp2":182,"output":185,"carryOut":184,"controlSignalInput":183}}}],"Text":[{"x":200,"y":40,"objectType":"Text","label":"verso a","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["verso a",14]}},{"x":-1400,"y":-870,"objectType":"Text","label":"### Addizione e sottrazione in Floating Point\n\nIl circuito implementa le operazioni di **addizione e sottrazione in floating point**.\n\nIn ingresso vengono forniti:\n\n* i due operandi **A** e **B**;\n* il numero di cifre decimali associate ai due operandi, rispettivamente **a_decimal** e **b_decimal**;\n* il segno dei due operandi, rispettivamente **a_sign** e **b_sign**.\n\n#### Determinazione dell'operazione\n\nLa scelta tra addizione e sottrazione viene determinata mediante una porta **XOR** sui due segni.\n\n* Se i due operandi hanno **lo stesso segno**, viene eseguita un'**addizione**.\n* Se i due operandi hanno **segno opposto**, viene eseguita una **sottrazione**.\n\nIl segno del risultato viene determinato in base ai valori e ai segni degli operandi:\n\n* il risultato è **positivo** se entrambi gli operandi sono positivi;\n* nel caso di segni differenti, il risultato assume il segno dell'operando con **valore assoluto maggiore**;\n* negli altri casi, il risultato è **negativo**.\n\n#### Normalizzazione degli operandi\n\nPoiché le operazioni aritmetiche vengono eseguite utilizzando **numeri interi**, gli operandi vengono prima normalizzati eliminando temporaneamente la virgola decimale.\n\nPer fare questo, ciascun operando viene moltiplicato per una potenza di 10. L'esponente viene determinato considerando l'operando con il **numero maggiore di cifre decimali**.\n\nIn questo modo i due operandi vengono convertiti in valori interi mantenendo la corretta proporzione tra le loro parti decimali.\n\nIl numero di cifre decimali utilizzato per la normalizzazione viene inoltre mantenuto e fornito in uscita. Il parametro **out_dec** rappresenta quindi il numero di cifre decimali del risultato **out**.\n\nInfine, il circuito fornisce in uscita:\n\n* **out**: il valore numerico del risultato;\n* **out_dec**: il numero di cifre decimali del risultato;\n* **out_sign**: il segno del risultato.\n\n#### Gestione dell'overflow\n\nNel caso in cui durante l'operazione si verifichi un **overflow**, il circuito restituisce un valore nullo come segnalazione dell'errore:\n\n* **out = 0**\n* **out_dec = 0**\n* **out_sign = 0**\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["### Addizione e sottrazione in Floating Point\n\nIl circuito implementa le operazioni di **addizione e sottrazione in floating point**.\n\nIn ingresso vengono forniti:\n\n* i due operandi **A** e **B**;\n* il numero di cifre decimali associate ai due operandi, rispettivamente **a_decimal** e **b_decimal**;\n* il segno dei due operandi, rispettivamente **a_sign** e **b_sign**.\n\n#### Determinazione dell'operazione\n\nLa scelta tra addizione e sottrazione viene determinata mediante una porta **XOR** sui due segni.\n\n* Se i due operandi hanno **lo stesso segno**, viene eseguita un'**addizione**.\n* Se i due operandi hanno **segno opposto**, viene eseguita una **sottrazione**.\n\nIl segno del risultato viene determinato in base ai valori e ai segni degli operandi:\n\n* il risultato è **positivo** se entrambi gli operandi sono positivi;\n* nel caso di segni differenti, il risultato assume il segno dell'operando con **valore assoluto maggiore**;\n* negli altri casi, il risultato è **negativo**.\n\n#### Normalizzazione degli operandi\n\nPoiché le operazioni aritmetiche vengono eseguite utilizzando **numeri interi**, gli operandi vengono prima normalizzati eliminando temporaneamente la virgola decimale.\n\nPer fare questo, ciascun operando viene moltiplicato per una potenza di 10. L'esponente viene determinato considerando l'operando con il **numero maggiore di cifre decimali**.\n\nIn questo modo i due operandi vengono convertiti in valori interi mantenendo la corretta proporzione tra le loro parti decimali.\n\nIl numero di cifre decimali utilizzato per la normalizzazione viene inoltre mantenuto e fornito in uscita. Il parametro **out_dec** rappresenta quindi il numero di cifre decimali del risultato **out**.\n\nInfine, il circuito fornisce in uscita:\n\n* **out**: il valore numerico del risultato;\n* **out_dec**: il numero di cifre decimali del risultato;\n* **out_sign**: il segno del risultato.\n\n#### Gestione dell'overflow\n\nNel caso in cui durante l'operazione si verifichi un **overflow**, il circuito restituisce un valore nullo come segnalazione dell'errore:\n\n* **out = 0**\n* **out_dec = 0**\n* **out_sign = 0**\n",14]}},{"x":470,"y":1090,"objectType":"Text","label":"** IItalian\n**Circuito per la determinazione del segno in uscita.** Il risultato è negativo nei seguenti casi:\n\n1. **A < 0 e B < 0:** entrambi gli ingressi sono negativi.\n2. **A > 0 e B < 0:** il segno è determinato dal risultato della sottrazione **A − B**.\n3. **A < 0 e B > 0:** il segno è determinato dal risultato della sottrazione **A − B**, ma viene invertito.\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["** IItalian\n**Circuito per la determinazione del segno in uscita.** Il risultato è negativo nei seguenti casi:\n\n1. **A < 0 e B < 0:** entrambi gli ingressi sono negativi.\n2. **A > 0 e B < 0:** il segno è determinato dal risultato della sottrazione **A − B**.\n3. **A < 0 e B > 0:** il segno è determinato dal risultato della sottrazione **A − B**, ma viene invertito.\n",14]}},{"x":-1080,"y":490,"objectType":"Text","label":"Le cifre decimali dell'uscita e' il max di quelle degli ingressi. \nSe c'è overflow out_dec viene posto a 0.","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["Le cifre decimali dell'uscita e' il max di quelle degli ingressi. \nSe c'è overflow out_dec viene posto a 0.",14]}},{"x":190,"y":610,"objectType":"Text","label":"10 ^ 1 = 10","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["10 ^ 1 = 10",14]}},{"x":190,"y":630,"objectType":"Text","label":"10 ^ 0 = 1","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["10 ^ 0 = 1",14]}},{"x":180,"y":650,"objectType":"Text","label":"10 ^ 2 = 100","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["10 ^ 2 = 100",14]}},{"x":170,"y":670,"objectType":"Text","label":"10 ^ 3 = 1000","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["10 ^ 3 = 1000",14]}},{"x":160,"y":690,"objectType":"Text","label":"10 ^ 4 = 10000","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["10 ^ 4 = 10000",14]}},{"x":170,"y":390,"objectType":"Text","label":"Viene selezionato il valore corrispondente alla potenza di dieci indicata dal selettore","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["Viene selezionato il valore corrispondente alla potenza di dieci indicata dal selettore",14]}},{"x":-250,"y":230,"objectType":"Text","label":"Viene normalizzato A se le sue cifre decimali sono inferiori a B , \naltrimenti viene normalizzato B.\nLa normalizzazione avviene moltiplicando il\n numero per 10 ^ n dove n e' la differenza tra le cifre decimali.","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["Viene normalizzato A se le sue cifre decimali sono inferiori a B , \naltrimenti viene normalizzato B.\nLa normalizzazione avviene moltiplicando il\n numero per 10 ^ n dove n e' la differenza tra le cifre decimali.",14]}},{"x":1390,"y":350,"objectType":"Text","label":"decisione dell'operazione\nda prelevare","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["decisione dell'operazione\nda prelevare",14]}},{"x":1800,"y":550,"objectType":"Text","label":"Se c'è overflow, l'uscita e il segno vengono posti a 0.","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["Se c'è overflow, l'uscita e il segno vengono posti a 0.",14]}},{"x":1580,"y":950,"objectType":"Text","label":"In case of overflow, the sign is forced to 0 through an AND gate. \nIn the absence of overflow, the sign follows the input value, which in this case is 1.","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["In case of overflow, the sign is forced to 0 through an AND gate. \nIn the absence of overflow, the sign follows the input value, which in this case is 1.",14]}},{"x":1250,"y":1050,"objectType":"Text","label":"both negative","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["both negative",14]}},{"x":1060,"y":980,"objectType":"Text","label":"If A > 0 and B < 0, the sign of the result is determined by the subtraction (A − B)","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["If A > 0 and B < 0, the sign of the result is determined by the subtraction (A − B)",14]}},{"x":1190,"y":840,"objectType":"Text","label":"**If A < 0 and B > 0, the sign of the subtraction result (A − B) is inverted.**\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["**If A < 0 and B > 0, the sign of the subtraction result (A − B) is inverted.**\n",14]}},{"x":250,"y":460,"objectType":"Text","label":"verso b","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["verso b",14]}},{"x":-150,"y":-360,"objectType":"Text","label":"Example:\n-345.32 + 65.4 = −279,92 \n\nA = 1000011011100100 (34532)\na_decimal = 0010 (2)\na_sign = 1\n\nB= 1010001110 (654)\nb_decimal = 0001 (1)\nb_sign=0\n\nout = 110110101011000 (27992)\nout_dec = 0010 (2)\nout_sign = 1\n\n\n\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["Example:\n-345.32 + 65.4 = −279,92 \n\nA = 1000011011100100 (34532)\na_decimal = 0010 (2)\na_sign = 1\n\nB= 1010001110 (654)\nb_decimal = 0001 (1)\nb_sign=0\n\nout = 110110101011000 (27992)\nout_dec = 0010 (2)\nout_sign = 1\n\n\n\n",14]}},{"x":640,"y":-1120,"objectType":"Text","label":"### Floating-Point Addition and Subtraction\n\nThe circuit implements **floating-point addition and subtraction**.\n\nThe inputs are:\n\n* the two operands **A** and **B**;\n* the number of decimal digits associated with each operand, **a_decimal** and **b_decimal**;\n* the sign of each operand, **a_sign** and **b_sign**.\n\n#### Operation Selection\n\nThe choice between addition and subtraction is determined using an **XOR gate** applied to the two signs.\n\n* If the two operands have the **same sign**, an **addition** is performed.\n* If the two operands have **opposite signs**, a **subtraction** is performed.\n\nThe sign of the result is determined according to the values and signs of the operands:\n\n* the result is **positive** if both operands are positive;\n* if the operands have different signs, the result takes the sign of the operand with the **greater absolute value**;\n* in all other cases, the result is **negative**.\n\n#### Operand Normalization\n\nSince the arithmetic operations are performed using **integer values**, the operands are first normalized by temporarily removing the decimal point.\n\nTo achieve this, each operand is multiplied by a power of 10. The exponent is determined according to the operand with the **largest number of decimal digits**.\n\nThis converts both operands into integer values while preserving the correct relationship between their decimal parts.\n\nThe number of decimal digits used for the normalization is also retained and provided as an output. The **out_dec** parameter therefore represents the number of decimal digits in the resulting value **out**.\n\nThe circuit ultimately provides the following outputs:\n\n* **out**: the numerical value of the result;\n* **out_dec**: the number of decimal digits in the result;\n* **out_sign**: the sign of the result.\n\n#### Overflow Handling\n\nIf an **overflow** occurs during the operation, the circuit outputs zero values to indicate the error:\n\n* **out = 0**\n* **out_dec = 0**\n* **out_sign = 0**\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["### Floating-Point Addition and Subtraction\n\nThe circuit implements **floating-point addition and subtraction**.\n\nThe inputs are:\n\n* the two operands **A** and **B**;\n* the number of decimal digits associated with each operand, **a_decimal** and **b_decimal**;\n* the sign of each operand, **a_sign** and **b_sign**.\n\n#### Operation Selection\n\nThe choice between addition and subtraction is determined using an **XOR gate** applied to the two signs.\n\n* If the two operands have the **same sign**, an **addition** is performed.\n* If the two operands have **opposite signs**, a **subtraction** is performed.\n\nThe sign of the result is determined according to the values and signs of the operands:\n\n* the result is **positive** if both operands are positive;\n* if the operands have different signs, the result takes the sign of the operand with the **greater absolute value**;\n* in all other cases, the result is **negative**.\n\n#### Operand Normalization\n\nSince the arithmetic operations are performed using **integer values**, the operands are first normalized by temporarily removing the decimal point.\n\nTo achieve this, each operand is multiplied by a power of 10. The exponent is determined according to the operand with the **largest number of decimal digits**.\n\nThis converts both operands into integer values while preserving the correct relationship between their decimal parts.\n\nThe number of decimal digits used for the normalization is also retained and provided as an output. The **out_dec** parameter therefore represents the number of decimal digits in the resulting value **out**.\n\nThe circuit ultimately provides the following outputs:\n\n* **out**: the numerical value of the result;\n* **out_dec**: the number of decimal digits in the result;\n* **out_sign**: the sign of the result.\n\n#### Overflow Handling\n\nIf an **overflow** occurs during the operation, the circuit outputs zero values to indicate the error:\n\n* **out = 0**\n* **out_dec = 0**\n* **out_sign = 0**\n",14]}},{"x":-490,"y":390,"objectType":"Text","label":"If **A** has fewer decimal digits than **B**, **A** is normalized; otherwise, **B** is normalized.\n\nNormalization consists of multiplying the number by **10ⁿ**, \nwhere **n** is the difference between the number of decimal digits of the two operands.\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["If **A** has fewer decimal digits than **B**, **A** is normalized; otherwise, **B** is normalized.\n\nNormalization consists of multiplying the number by **10ⁿ**, \nwhere **n** is the difference between the number of decimal digits of the two operands.\n",14]}},{"x":-1100,"y":610,"objectType":"Text","label":"The number of decimal digits of the output, **out_dec**, is equal to the **\nmaximum number of decimal digits among the two inputs**.\n\nIn case of **overflow**, **out_dec** is set to **0**.\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["The number of decimal digits of the output, **out_dec**, is equal to the **\nmaximum number of decimal digits among the two inputs**.\n\nIn case of **overflow**, **out_dec** is set to **0**.\n",14]}},{"x":60,"y":520,"objectType":"Text","label":"The value corresponding to the power of ten specified by the selector is selected.","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["The value corresponding to the power of ten specified by the selector is selected.",14]}},{"x":1350,"y":430,"objectType":"Text","label":"Selection of the operation to be performed","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["Selection of the operation to be performed",14]}},{"x":1210,"y":1090,"objectType":"Text","label":"**English:**\n**Circuit for determining the output sign.** The result is negative in the following cases:\n\n1. **A < 0 and B < 0:** both inputs are negative.\n2. **A > 0 and B < 0:** the sign is determined by the result of the subtraction **A − B**.\n3. **A < 0 and B > 0:** the sign is determined by the result of the subtraction **A − B**, but it is inverted.\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["**English:**\n**Circuit for determining the output sign.** The result is negative in the following cases:\n\n1. **A < 0 and B < 0:** both inputs are negative.\n2. **A > 0 and B < 0:** the sign is determined by the result of the subtraction **A − B**.\n3. **A < 0 and B > 0:** the sign is determined by the result of the subtraction **A − B**, but it is inverted.\n",14]}}],"Arrow":[{"x":890,"y":1020,"objectType":"Arrow","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["RIGHT"]}}],"restrictedCircuitElementsUsed":[],"nodes":[21,22,23,41,42,47,52,53,54,55,56,60,66,69,70,71,72,77,78,79,80,85,86,87,92,93,94,95,103,104,105,106,107,110,111,112,121,123,127,128,129,130,131,132,133,137,138,139,144,145,146,147,151,155,172,173,174,175,176,177,178,179,180,187,192,193,197,198,199,201,202,203,204,215,216,217,218,219,226,227,228,229,230]},{"layout":{"width":100,"height":140,"title_x":50,"title_y":13,"titleEnabled":true},"verilogMetadata":{"isVerilogCircuit":false,"isMainCircuit"