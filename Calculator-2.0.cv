rcuit":true,"labelDirection":"DOWN","x":0,"y":0}},{"x":930,"y":190,"objectType":"DigitalLed","label":"","direction":"UP","labelDirection":"DOWN","propagationDelay":10,"customData":{"constructorParamaters":["Red"],"nodes":{"inp1":26}},"subcircuitMetadata":{"showInSubcircuit":false,"showLabelInSubcircuit":true,"labelDirection":"DOWN","x":0,"y":0}},{"x":1300,"y":230,"objectType":"DigitalLed","label":"","direction":"UP","labelDirection":"DOWN","propagationDelay":10,"customData":{"constructorParamaters":["Red"],"nodes":{"inp1":154}},"subcircuitMetadata":{"showInSubcircuit":false,"showLabelInSubcircuit":true,"labelDirection":"DOWN","x":0,"y":0}}],"SubCircuit":[{"x":390,"y":150,"id":"17806584285","label":"","labelDirection":"LEFT","inputNodes":[4,5,6],"outputNodes":[1,2,3],"version":"2.0"},{"x":590,"y":190,"id":"24352196407","label":"","labelDirection":"LEFT","inputNodes":[12,13],"outputNodes":[10,11],"version":"2.0"},{"x":770,"y":190,"id":"17806584285","label":"","labelDirection":"LEFT","inputNodes":[18,19,20],"outputNodes":[15,16,17],"version":"2.0"},{"x":970,"y":230,"id":"24352196407","label":"","labelDirection":"LEFT","inputNodes":[29,30],"outputNodes":[27,28],"version":"2.0"},{"x":1140,"y":230,"id":"17806584285","label":"","labelDirection":"LEFT","inputNodes":[34,35,36],"outputNodes":[31,32,33],"version":"2.0"},{"x":1080,"y":550,"id":"9598005358","label":"","labelDirection":"LEFT","inputNodes":[47,48,49,50,51],"outputNodes":[45,46],"version":"2.0"},{"x":1250,"y":640,"id":"78170471873","label":"","labelDirection":"LEFT","inputNodes":[72,73,74],"outputNodes":[70,71],"version":"2.0"},{"x":590,"y":660,"id":"24352196407","label":"","labelDirection":"LEFT","inputNodes":[79,80],"outputNodes":[77,78],"version":"2.0"}],"Tunnel":[{"x":1590,"y":610,"objectType":"Tunnel","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["RIGHT",1,"O"],"nodes":{"inp1":173},"values":{"identifier":"O"}}},{"x":40,"y":800,"objectType":"Tunnel","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["RIGHT",1,"O"],"nodes":{"inp1":182},"values":{"identifier":"O"}}},{"x":-150,"y":110,"objectType":"Tunnel","label":"","direction":"LEFT","labelDirection":"RIGHT","propagationDelay":10,"customData":{"constructorParamaters":["LEFT",1,"O"],"nodes":{"inp1":189},"values":{"identifier":"O"}}}],"ALU":[{"x":-190,"y":370,"objectType":"ALU","label":"","direction":"DOWN","labelDirection":"UP","propagationDelay":10,"customData":{"constructorParamaters":["DOWN",4],"nodes":{"inp1":85,"inp2":86,"output":89,"carryOut":88,"controlSignalInput":87}}},{"x":-160,"y":470,"objectType":"ALU","label":"","direction":"DOWN","labelDirection":"UP","propagationDelay":10,"customData":{"constructorParamaters":["DOWN",4],"nodes":{"inp1":92,"inp2":93,"output":96,"carryOut":95,"controlSignalInput":94}}},{"x":-150,"y":590,"objectType":"ALU","label":"","direction":"DOWN","labelDirection":"UP","propagationDelay":10,"customData":{"constructorParamaters":["DOWN",4],"nodes":{"inp1":105,"inp2":106,"output":109,"carryOut":108,"controlSignalInput":107}}},{"x":30,"y":590,"objectType":"ALU","label":"","direction":"DOWN","labelDirection":"UP","propagationDelay":10,"customData":{"constructorParamaters":["DOWN",4],"nodes":{"inp1":118,"inp2":119,"output":122,"carryOut":121,"controlSignalInput":120}}}],"Text":[{"x":720,"y":180,"objectType":"Text","label":"r x 10","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["r x 10",14]}},{"x":890,"y":200,"objectType":"Text","label":"q1","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["q1",14]}},{"x":1260,"y":230,"objectType":"Text","label":"q2","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["q2",14]}},{"x":-1120,"y":-100,"objectType":"Text","label":"Divisione in virgola mobile con segno a 32 bit.\nIl segno dell’uscita è determinato tramite un’operazione XOR tra i corrispondenti segnali di segno degli ingressi. \nIl risultato è positivo quando i due segni di ingresso sono concordi e negativo quando sono discordi.\n\nIl numero di cifre decimali dell’uscita, out_dec, è determinato dalla seguente espressione:\n\nout_dec = n_a + 2 − n_b\n\nAnche in questo caso viene eseguita una fase di normalizzazione, \nottenuta moltiplicando i valori per opportune potenze di 10. Il termine +2 \npresente nell’espressione è dovuto al fatto che il divisore a 32 bit è configurato \nper produrre due cifre decimali. Come mostrato nei due stadi aggiuntivi a destra del circuito di divisione, \nil resto viene moltiplicato per 10 per consentire la generazione delle successive cifre decimali.\n\nIn caso di overflow, tutte le uscite vengono poste a 0.","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["Divisione in virgola mobile con segno a 32 bit.\nIl segno dell’uscita è determinato tramite un’operazione XOR tra i corrispondenti segnali di segno degli ingressi. \nIl risultato è positivo quando i due segni di ingresso sono concordi e negativo quando sono discordi.\n\nIl numero di cifre decimali dell’uscita, out_dec, è determinato dalla seguente espressione:\n\nout_dec = n_a + 2 − n_b\n\nAnche in questo caso viene eseguita una fase di normalizzazione, \nottenuta moltiplicando i valori per opportune potenze di 10. Il termine +2 \npresente nell’espressione è dovuto al fatto che il divisore a 32 bit è configurato \nper produrre due cifre decimali. Come mostrato nei due stadi aggiuntivi a destra del circuito di divisione, \nil resto viene moltiplicato per 10 per consentire la generazione delle successive cifre decimali.\n\nIn caso di overflow, tutte le uscite vengono poste a 0.",14]}},{"x":150,"y":540,"objectType":"Text","label":"Normalizzazione del quoziente: il quoziente viene moltiplicato per 100 in base decimale, \ncorrispondente a 1100100 in binario, per tenere conto delle due cifre decimali.","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["Normalizzazione del quoziente: il quoziente viene moltiplicato per 100 in base decimale, \ncorrispondente a 1100100 in binario, per tenere conto delle due cifre decimali.",14]}},{"x":1090,"y":200,"objectType":"Text","label":"r x 10","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["r x 10",14]}},{"x":1310,"y":330,"objectType":"Text","label":"Le ultime due cifre del quoziente rappresentano le due cifre decimali del risultato.\nDevono quindi essere convertite in binario e sommate alla parte restante del quoziente, \nche è già espressa in formato binario.","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["Le ultime due cifre del quoziente rappresentano le due cifre decimali del risultato.\nDevono quindi essere convertite in binario e sommate alla parte restante del quoziente, \nche è già espressa in formato binario.",14]}},{"x":-50,"y":-410,"objectType":"Text","label":"Example \n56,34 : - 15,28 = - 3,68\n\nA = 1011000000010  (5634)\nn_a =  0010 (2)\na_sign=0\n\nB = 10111111000 (1528)\nn_b=  0010 (2)\nb_sign = 1\n\nout=101110000  (368)\nout_dec = 0010 (2)\nout_sign=1\n\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["Example \n56,34 : - 15,28 = - 3,68\n\nA = 1011000000010  (5634)\nn_a =  0010 (2)\na_sign=0\n\nB = 10111111000 (1528)\nn_b=  0010 (2)\nb_sign = 1\n\nout=101110000  (368)\nout_dec = 0010 (2)\nout_sign=1\n\n",22]}},{"x":-210,"y":140,"objectType":"Text","label":"overflow","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["overflow",14]}},{"x":50,"y":840,"objectType":"Text","label":"In case of overflow, out_dec is set to 0.","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["In case of overflow, out_dec is set to 0.",14]}},{"x":1540,"y":650,"objectType":"Text","label":"In case of overflow, the output is set to 0.","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["In case of overflow, the output is set to 0.",14]}},{"x":860,"y":-270,"objectType":"Text","label":"Signed 32-bit floating-point division.\nThe output sign is determined by applying an XOR operation to the corresponding \nsign signals of the inputs. The result is positive when the two input signs \nare the same and negative when they are different.\n\nThe number of decimal digits in the output, out_dec, is determined by the following expression:\n\nout_dec = n_a + 2 − n_b\n\nA normalization step is also performed in this case, by multiplying the values by appropriate powers of 10. \nThe +2 term in the expression is due to the fact that the 32-bit divider is configured to produce two decimal digits. \nAs shown in the two additional stages on the right side of the division circuit, the remainder is multiplied by 10 \nto generate the subsequent decimal digits.\n\nIn case of overflow, all outputs are set to 0.","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["Signed 32-bit floating-point division.\nThe output sign is determined by applying an XOR operation to the corresponding \nsign signals of the inputs. The result is positive when the two input signs \nare the same and negative when they are different.\n\nThe number of decimal digits in the output, out_dec, is determined by the following expression:\n\nout_dec = n_a + 2 − n_b\n\nA normalization step is also performed in this case, by multiplying the values by appropriate powers of 10. \nThe +2 term in the expression is due to the fact that the 32-bit divider is configured to produce two decimal digits. \nAs shown in the two additional stages on the right side of the division circuit, the remainder is multiplied by 10 \nto generate the subsequent decimal digits.\n\nIn case of overflow, all outputs are set to 0.",14]}},{"x":1380,"y":400,"objectType":"Text","label":"The last two digits of the quotient represent the two decimal digits of the result. \nThey must therefore be converted into binary and added to the remaining part of the quotient, \nwhich is already represented in binary format.","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["The last two digits of the quotient represent the two decimal digits of the result. \nThey must therefore be converted into binary and added to the remaining part of the quotient, \nwhich is already represented in binary format.",14]}},{"x":190,"y":630,"objectType":"Text","label":"Quotient normalization: the quotient is multiplied by 100 in decimal, \ncorresponding to 1100100 in binary, to account for the two decimal digits","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["Quotient normalization: the quotient is multiplied by 100 in decimal, \ncorresponding to 1100100 in binary, to account for the two decimal digits",14]}}],"restrictedCircuitElementsUsed":[],"nodes":[8,21,22,23,24,25,37,38,39,40,41,42,43,44,52,59,60,61,62,63,64,66,67,68,69,75,82,91,99,103,104,111,112,113,114,115,116,117,123,124,126,127,128,133,134,135,136,137,138,139,140,141,142,143,144,145,146,152,166,167,168,169,170,174,175,176,184,185]},{"layout":{"width":100,"height":340,"title_x":50,"title_y":13,"titleEnabled":true},"verilogMetadata":{"isVerilogCircuit":false,"isMainCircuit":false,"code":"// Write Some Verilog Code Here!","subCircuitScopeIds":[]},"allNodes":[{"x":-10,"y":-10,"type":0,"bitWidth":16,"label":"","connections":[41]},{"x":-10,"y":10,"type":0,"bitWidth":16,"label":"","connections":[30]},{"x":10,"y":0,"type":1,"bitWidth":16,"label":"","connections":[31]},{"x":0,"y":20,"type":0,"bitWidth":1,"l