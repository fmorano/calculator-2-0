bCircuit":[{"x":560,"y":200,"id":"39279437839","label":"","labelDirection":"LEFT","inputNodes":[6,7,8],"outputNodes":[2,3,4,5],"version":"2.0"},{"x":820,"y":200,"id":"39279437839","label":"","labelDirection":"LEFT","inputNodes":[16,17,18],"outputNodes":[12,13,14,15],"version":"2.0"},{"x":1100,"y":200,"id":"39279437839","label":"","labelDirection":"LEFT","inputNodes":[31,32,33],"outputNodes":[27,28,29,30],"version":"2.0"},{"x":1380,"y":200,"id":"39279437839","label":"","labelDirection":"LEFT","inputNodes":[44,45,46],"outputNodes":[40,41,42,43],"version":"2.0"},{"x":1650,"y":200,"id":"39279437839","label":"","labelDirection":"LEFT","inputNodes":[58,59,60],"outputNodes":[54,55,56,57],"version":"2.0"},{"x":1940,"y":200,"id":"39279437839","label":"","labelDirection":"LEFT","inputNodes":[70,71,72],"outputNodes":[66,67,68,69],"version":"2.0"},{"x":2200,"y":200,"id":"39279437839","label":"","labelDirection":"LEFT","inputNodes":[83,84,85],"outputNodes":[79,80,81,82],"version":"2.0"},{"x":2460,"y":200,"id":"39279437839","label":"","labelDirection":"LEFT","inputNodes":[96,97,98],"outputNodes":[92,93,94,95],"version":"2.0"},{"x":2730,"y":200,"id":"39279437839","label":"","labelDirection":"LEFT","inputNodes":[109,110,111],"outputNodes":[105,106,107,108],"version":"2.0"}],"Text":[{"x":2950,"y":370,"objectType":"Text","label":"10 (dec)","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["10 (dec)",14]}},{"x":2660,"y":390,"objectType":"Text","label":"100 (dec)","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["100 (dec)",14]}},{"x":2400,"y":410,"objectType":"Text","label":"1000 (dec)","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["1000 (dec)",14]}},{"x":2130,"y":430,"objectType":"Text","label":"10000 (dec)","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["10000 (dec)",14]}},{"x":1830,"y":450,"objectType":"Text","label":"100000 (dec)","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["100000 (dec)",14]}},{"x":1560,"y":470,"objectType":"Text","label":"1000000 (dec)","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["1000000 (dec)",14]}},{"x":1230,"y":490,"objectType":"Text","label":"10000000 (dec)","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["10000000 (dec)",14]}},{"x":880,"y":510,"objectType":"Text","label":"100000000 (dec)","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["100000000 (dec)",14]}},{"x":720,"y":530,"objectType":"Text","label":"1000000000 (dec)","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["1000000000 (dec)",14]}},{"x":130,"y":-30,"objectType":"Text","label":"### Conversione da un numero binario a 32 bit a un numero decimale di 9 cifre in formato BCD\n\nLa conversione viene realizzata utilizzando più circuiti **Single-Digit-Converter2** collegati in cascata.\n\nCome valore di riferimento, si parte da **100.000.000** e si procede successivamente con **10.000.000, 1.000.000, 100.000, 10.000, 1.000, 100, 10 e 1**, fino a ottenere l'ultima cifra decimale.\n\nOgni stadio determina una singola cifra decimale in formato **BCD** e passa il resto della conversione allo stadio successivo.\n\nIn questo modo, il numero binario a 32 bit viene progressivamente scomposto nelle sue **9 cifre decimali**, ciascuna rappresentata utilizzando 4 bit in formato BCD.\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["### Conversione da un numero binario a 32 bit a un numero decimale di 9 cifre in formato BCD\n\nLa conversione viene realizzata utilizzando più circuiti **Single-Digit-Converter2** collegati in cascata.\n\nCome valore di riferimento, si parte da **100.000.000** e si procede successivamente con **10.000.000, 1.000.000, 100.000, 10.000, 1.000, 100, 10 e 1**, fino a ottenere l'ultima cifra decimale.\n\nOgni stadio determina una singola cifra decimale in formato **BCD** e passa il resto della conversione allo stadio successivo.\n\nIn questo modo, il numero binario a 32 bit viene progressivamente scomposto nelle sue **9 cifre decimali**, ciascuna rappresentata utilizzando 4 bit in formato BCD.\n",14]}},{"x":1800,"y":-20,"objectType":"Text","label":"### Conversion from a 32-bit binary number to a 9-digit decimal number in BCD format\n\nThe conversion is implemented using multiple **Single-Digit-Converter2** circuits connected in cascade.\n\nThe reference value starts at **100,000,000** and is then successively reduced to **10,000,000, 1,000,000, 100,000, 10,000, 1,000, 100, 10, and 1**, until the final decimal digit is obtained.\n\nEach stage determines one decimal digit in **BCD** format and passes the remaining value to the next stage.\n\nIn this way, the 32-bit binary number is progressively decomposed into its **9 decimal digits**, with each digit represented using 4 bits in BCD format.\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["### Conversion from a 32-bit binary number to a 9-digit decimal number in BCD format\n\nThe conversion is implemented using multiple **Single-Digit-Converter2** circuits connected in cascade.\n\nThe reference value starts at **100,000,000** and is then successively reduced to **10,000,000, 1,000,000, 100,000, 10,000, 1,000, 100, 10, and 1**, until the final decimal digit is obtained.\n\nEach stage determines one decimal digit in **BCD** format and passes the remaining value to the next stage.\n\nIn this way, the 32-bit binary number is progressively decomposed into its **9 decimal digits**, with each digit represented using 4 bits in BCD format.\n",14]}}],"restrictedCircuitElementsUsed":[],"nodes":[9,11,20,21,22,23,24,26,35,36,37,39,48,49,50,52,61,62,63,65,74,75,76,78,87,88,89,91,100,101,102,104,113,114,115,117,122,125,127,128,129,130,131,132,133,134,135,136,137,138,149,150,151,152,153,154,155,156,157,158,159,160,161,162,163,164,165,166,167,168]},{"layout":{"width":100,"height":120,"title_x":50,"title_y":13,"titleEnabled":true},"verilogMetadata":{"isVerilogCircuit":false,"isMainCircuit":false,"code":"// Write Some Verilog Code Here!","subCircuitScopeIds":[]},"allNodes":[{"x":10,"y":0,"type":1,"bitWidth":4,"label":"","connections":[14]},{"x":100,"y":20,"type":1,"bitWidth":32,"label":"","connections":[26]},{"x":100,"y":40,"type":1,"bitWidth":1,"label":"","connections":[]},{"x":0,"y":20,"type":0,"bitWidth":16,"label":"","connections":[6]},{"x":0,"y":40,"type":0,"bitWidth":16,"label":"","connections":[22]},{"x":10,"y":0,"type":1,"bitWidth":16,"label":"","connections":[22]},{"x":-10,"y":10,"type":0,"bitWidth":16,"label":"","connections":[3]},{"x":20,"y":-20,"type":0,"bitWidth":4,"label":"","connections":[14]},{"x":20,"y":0,"type":0,"bitWidth":12,"label":"","connections":[21]},{"x":10,"y":0,"type":1,"bitWidth":12,"label":"","connections":[21]},{"x":100,"y":20,"type":1,"bitWidth":32,"label":"","connections":[27]},{"x":100,"y":40,"type":1,"bitWidth":1,"label":"","connections":[]},{"x":0,"y":20,"type":0,"bitWidth":16,"label":"","connections":[16]},{"x":0,"y":40,"type":0,"bitWidth":16,"label":"","connections":[25]},{"x":590,"y":170,"type":2,"bitWidth":4,"label":"","connections":[0,7]},{"x":10,"y":0,"type":1,"bitWidth":12,"label":"","connections":[23]},{"x":-10,"y":10,"type":0,"bitWidth":16,"label":"","connections":[12]},{"x":20,"y":-20,"type":0,"bitWidth":4,"label":"","connections":[20]},{"x":20,"y":0,"type":0,"bitWidth":12,"label":"","connections":[23]},{"x":10,"y":0,"type":1,"bitWidth":4,"label":"","connections":[20]},{"x":920,"y":170,"type":2,"bitWidth":4,"label":"","connections":[17,19]},{"x":510,"y":190,"type":2,"bitWid