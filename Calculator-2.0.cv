":{"nodes":{"output1":2},"values":{"state":0},"constructorParamaters":["RIGHT",1,{"x":0,"y":60,"id":"xpP51HbccxQtAu9x1C96"}]}},{"x":380,"y":380,"objectType":"Input","label":"op_=","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":0,"customData":{"nodes":{"output1":3},"values":{"state":0},"constructorParamaters":["RIGHT",1,{"x":0,"y":80,"id":"6ey9SScnN09K3CkBTGTA"}]}},{"x":380,"y":400,"objectType":"Input","label":"store_:","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":0,"customData":{"nodes":{"output1":4},"values":{"state":0},"constructorParamaters":["RIGHT",1,{"x":0,"y":100,"id":"pHWtPsSgYGSOKykH9Gm0"}]}}],"Output":[{"x":670,"y":440,"objectType":"Output","label":"st_div","direction":"LEFT","labelDirection":"RIGHT","propagationDelay":0,"customData":{"nodes":{"inp1":18},"constructorParamaters":["LEFT",1,{"x":100,"y":20,"id":"J0led1YD1xsVRFHMg6Tv"}]}},{"x":730,"y":360,"objectType":"Output","label":"st_ph","direction":"LEFT","labelDirection":"RIGHT","propagationDelay":0,"customData":{"nodes":{"inp1":19},"constructorParamaters":["LEFT",1,{"x":100,"y":40,"id":"fuk3kVPNYxTraEnjIBpd"}]}}],"NotGate":[{"x":450,"y":400,"objectType":"NotGate","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["RIGHT",1],"nodes":{"output1":6,"inp1":5}}}],"OrGate":[{"x":670,"y":360,"objectType":"OrGate","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["RIGHT",5,1],"nodes":{"inp":[20,21,22,23,24],"output1":25}}}],"AndGate":[{"x":520,"y":390,"objectType":"AndGate","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["RIGHT",2,1],"nodes":{"inp":[7,8],"output1":9}}},{"x":550,"y":440,"objectType":"AndGate","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["RIGHT",2,1],"nodes":{"inp":[15,16],"output1":17}}}],"Text":[{"x":-50,"y":-130,"objectType":"Text","label":"**Italiano**\n\n**Controllo dell’avvio dello schedulatore**\n\nIl circuito determina quando attivare il circuito sequenziale principale, responsabile del **caricamento dell’accumulatore** e del **clear** dell’input.\n\nQuesta gestione è necessaria perché l’operazione di **divisione** richiede più tempo rispetto alle operazioni di **addizione** e **moltiplicazione**.\n\nSe l’operazione selezionata è **“+”** o **“×”**, lo schedulatore viene attivato immediatamente alla pressione del tasto **“=”**.\n\nSe invece viene premuto **“=”** e l’operazione selezionata è la **divisione (“:”)**, il circuito genera prima un impulso di avvio per il modulo di divisione e attende il completamento dell’operazione.\n\nIl **Main** riceve dal circuito di divisione un segnale di **fine operazione**. Solo dopo aver ricevuto questo segnale, il Main attiva lo schedulatore principale descritto in precedenza.\n\n**English**\n\n**Scheduler activation control**\n\nThe circuit determines when to activate the main sequential circuit, which is responsible for **loading the accumulator** and **clearing** the input.\n\nThis control is necessary because the **division** operation requires more time than **addition** and **multiplication**.\n\nIf the selected operation is **“+”** or **“×”**, the scheduler is activated immediately when the **“=”** key is pressed.\n\nIf **“=”** is pressed and the selected operation is **division (“:”)**, the circuit first generates a start pulse for the division module and waits for the operation to complete.\n\nThe **Main** receives an **operation-complete** signal from the division circuit. Only after receiving this signal does the Main activate the main scheduler described above.\n","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["**Italiano**\n\n**Controllo dell’avvio dello schedulatore**\n\nIl circuito determina quando attivare il circuito sequenziale principale, responsabile del **caricamento dell’accumulatore** e del **clear** dell’input.\n\nQuesta gestione è necessaria perché l’operazione di **divisione** richiede più tempo rispetto alle operazioni di **addizione** e **moltiplicazione**.\n\nSe l’operazione selezionata è **“+”** o **“×”**, lo schedulatore viene attivato immediatamente alla pressione del tasto **“=”**.\n\nSe invece viene premuto **“=”** e l’operazione selezionata è la **divisione (“:”)**, il circuito genera prima un impulso di avvio per il modulo di divisione e attende il completamento dell’operazione.\n\nIl **Main** riceve dal circuito di divisione un segnale di **fine operazione**. Solo dopo aver ricevuto questo segnale, il Main attiva lo schedulatore principale descritto in precedenza.\n\n**English**\n\n**Scheduler activation control**\n\nThe circuit determines when to activate the main sequential circuit, which is responsible for **loading the accumulator** and **clearing** the input.\n\nThis control is necessary because the **division** operation requires more time than **addition** and **multiplication**.\n\nIf the selected operation is **“+”** or **“×”**, the scheduler is activated immediately when the **“=”** key is pressed.\n\nIf **“=”** is pressed and the selected operation is **division (“:”)**, the circuit first generates a start pulse for the division module and waits for the operation to complete.\n\nThe **Main** receives an **operation-complete** signal from the division circuit. Only after receiving this signal does the Main activate the main scheduler described above.\n",14]}}],"restrictedCircuitElementsUsed":[],"nodes":[10,11,12,13,14,26,27,28,29]},{"layout":{"width":100,"height":440,"title_x":50,"title_y":13,"titleEnabled":true},"verilogMetadata":{"isVerilogCircuit":false,"isMainCircuit":false,"code":"// Write Some Verilog Code Here!","subCircuitScopeIds":[]},"allNodes":[{"x":0,"y":60,"type":0,"bitWidth":32,"label":"","connections":[124]},{"x":0,"y":80,"type":0,"bitWidth":32,"label":"","c